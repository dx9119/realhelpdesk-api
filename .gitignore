# Компилированный код Java
*.class
target/
bin/

# Файлы IntelliJ IDEA
.idea/
.gigaide/
*.iml
*.iws
*.ipr
.DS_Store

# Файлы сборки Maven
# Maven Wrapper (mvnw, mvnw.cmd, .mvn/wrapper/) — коммитятся: гарантирует
# одинаковую версию Maven в CI и на хостах разработчиков

# Файлы сборки Gradle (если используется Gradle)
.gradle/
build/
settings.gradle.kts
gradle.properties
gradlew
gradlew.bat

# Лог-файлы
*.log

# Файлы виртуальной среды (если используются)
.venv/
venv/

# Файлы конфигурации, специфичные для локальной разработки (могут содержать пароли!)
# application-dev.properties не игнорируется: dev — отслеживаемый профиль проекта
# (уровни логов, секреты живут в infrastructure/.env).
application-local.properties
*.swp # Файлы подкачки Vim
*.swo # Файлы подкачки Vim

# Секретные ключи и файлы конфигурации (будьте осторожны!)
*.key
*.p12
*.pem
ssl/

# Локальные секреты (шаблоны — infrastructure/.env.dev.example, .env.prod.example)
infrastructure/.env

# Файлы Docker (если не коммитите образы)
# Dockerfile.local
# docker-compose.override.yml

# Прочие временные файлы и директории
tmp/
temp/
out/
.cache/

# Файлы отладки
hs_err_pid*

# Файлы профилирования
java_pid*

# Артефакты бэкапов (make backup)
backups/

# Артефакты локальных прогонов (make openapi / openapi-types): спека и типы
# снимаются с запущенного стека, в истории не нужны — контракт живёт в
# src/main/resources/openapi/schema-contract.json.
openapi.json
web/src/api/schema.d.ts
