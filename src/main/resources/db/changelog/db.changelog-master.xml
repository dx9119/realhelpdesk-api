<?xml version="1.0" encoding="UTF-8"?>
<!--
  Корневой changelog Liquibase. Подключается из application.properties:
      spring.liquibase.change-log=${DB_MIGRATIONS_CHANGE_LOG}
      DB_MIGRATIONS_CHANGE_LOG=classpath:db/changelog/db.changelog-master.xml

  Правила:
    * один файл на изменения — changes/NNN-<slug>.xml, нумерация возрастает и не меняется;
    * тяжёлый SQL лежит рядом в sql/ и подключается через <sqlFile> с путём
      от корня classpath (db/changelog/sql/NNN-<slug>.sql);
    * applied changesets не редактируются (контрольная сумма меняется — Liquibase упадёт),
      правка только через новый changeset;
    * изменения enum-значений в колонках с CHECK — отдельный changeset с пересозданием ограничения;
    * changes/ — только DDL (структура). Любые данные (INSERT/UPDATE/DELETE) —
      только в seed/ и только с context="seed": при DB_MIGRATIONS_CONTEXTS=schema
      (дефолт) база остаётся чистой, сид — make db-seed.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="changes/001-baseline-schema.xml" relativeToChangelogFile="true"/>
    <include file="changes/002-attachment-model.xml" relativeToChangelogFile="true"/>
    <include file="changes/003-portal-transfer-history.xml" relativeToChangelogFile="true"/>
    <include file="changes/004-jwt-tokens-created-at-index.xml" relativeToChangelogFile="true"/>
    <include file="changes/005-user-platform-source-keycloak.xml" relativeToChangelogFile="true"/>

    <!-- Фикстуры вне контекста schema: подключены, но применяются только при
         DB_MIGRATIONS_CONTEXTS=schema,seed (make db-seed). -->
    <include file="seed/100-demo-data.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
