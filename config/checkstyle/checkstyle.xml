<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Правила стиля RealHelpDesk.
  Форматирование (отступы, переносы, пробелы) контролирует Spotless — здесь только то,
  что он не проверяет: нейминг, импорты, дизайн, структура, стандарты тестов,
  ограничение сложности и гигиена исключений.

  Подавления — config/checkstyle/suppressions.xml (подключается через
  SuppressionFilter ниже, путь приходит из maven-checkstyle-plugin).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
        <property name="optional" value="true"/>
    </module>

    <!-- 120, а не 140: короткая строка принуждает выносить промежуточные
         результаты в именованные переменные вместо вложенных вызовов-«простыней». -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern"
                  value="^package.*|^import.*|http://|https://|ftp://|^\s*\*"/>
    </module>

    <!-- God Object по размеру файла: 350 строк — граница, после которой
         класс почти наверняка совмещает несколько ответственностей. -->
    <module name="FileLength">
        <property name="max" value="350"/>
    </module>

    <!-- Фиксированные паузы делают прогон медленным и флаки: ожидание
         условия — Awaitility. Допущен единственный файл в main, где пауза —
         часть backoff-механизма очистки refresh-токенов (см. suppressions.xml). -->
    <module name="RegexpSingleline">
        <property name="id" value="NoThreadSleepInTests"/>
        <property name="format" value="Thread\.sleep\("/>
    </module>

    <module name="TreeWalker">

        <!-- Импорты: явные, без wildcard, без дублей и мусора -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- В тестах — только AssertJ: JUnit Assertions дают менее информативные
             сообщения и смешивают два стиля в одном файле. Пакет нужен для
             static-импортов членов (Assertions.assertThat), класс — для импорта
             самого Assertions. -->
        <module name="IllegalImport">
            <property name="id" value="NoJUnitAssertions"/>
            <property name="illegalPkgs" value="org.junit.jupiter.api.Assertions"/>
            <property name="illegalClasses" value="org.junit.jupiter.api.Assertions"/>
        </module>

        <!-- JUnit 4 и TestNG в проекте не используются: смешение движков ломает
             отчёты и @DisplayName. Пакет org.junit перечислять нельзя — под ним
             живёт и JUnit 5 (org.junit.jupiter). -->
        <module name="IllegalImport">
            <property name="id" value="NoJUnit4AndTestNg"/>
            <property name="illegalPkgs"
                      value="org.junit.runner,org.junit.runners,org.junit.rules,org.junit.function,org.junit.matchers,org.junit.filters,org.testng"/>
            <property name="illegalClasses"
                      value="org.junit.Test,org.junit.Assert,org.junit.Assume,org.junit.Before,org.junit.After,org.junit.BeforeClass,org.junit.AfterClass,org.junit.Ignore,org.junit.Rule,org.junit.ClassRule,org.junit.FixMethodOrder"/>
        </module>

        <!-- Spring Boot 4 заменил @MockBean/@SpyBean на @MockitoBean/@MockitoSpyBean:
             старый пакет тянет пересоздание контекста на каждый тест-класс. -->
        <module name="IllegalImport">
            <property name="id" value="NoDeprecatedBootTestAnnotations"/>
            <property name="illegalPkgs" value="org.springframework.boot.test.mock.mockito"/>
        </module>

        <!-- Вывод в консоль не попадает в логи и не виден в CI-отчётах: в тестах —
             ассерты, в main — логгер. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoSystemOut"/>
            <property name="format" value="System\.(out|err)\.print|\.printStackTrace\("/>
        </module>

        <!-- EAGER-связи и каскады ALL/REMOVE — типичный «быстрый фикс» после
             LazyInitializationException. EAGER тянет лишние строки на каждый
             запрос; каскад скрывает жизненный цикл и удаляет/обновляет лишнее.
             Правильный путь: LAZY + EntityGraph / JOIN FETCH и явное управление
             дочерними сущностями. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoEagerFetch"/>
            <property name="format" value="FetchType\.EAGER"/>
            <property name="ignoreComments" value="true"/>
            <message key="regexp.exceeded"
                     value="FetchType.EAGER запрещен. Используй LAZY и EntityGraph / JOIN FETCH."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoCascadeAll"/>
            <property name="format" value="CascadeType\.(ALL|REMOVE)"/>
            <property name="ignoreComments" value="true"/>
            <message key="regexp.exceeded"
                     value="CascadeType.ALL/REMOVE запрещен: каскадное удаление и обновление скрывают связи. Управляй жизненным циклом явно."/>
        </module>

        <!-- Нейминг: PascalCase типы, camelCase методы/поля (с _ для методов тестов), CONST_CASE константы -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>
        <!-- В main подчёркиваний нет: имя метода — один camelCase-сегмент
             (в тестах действует конвенция method_condition_outcome). -->
        <module name="MethodName">
            <property name="id" value="MethodNameMain"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <!-- Исключение под конвенцию проекта: private static final Logger logger -->
        <module name="ConstantName">
            <property name="format" value="^([A-Z][A-Z0-9]*(_[A-Z0-9]+)*|logger)$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <module name="MemberName"/>
        <module name="LocalFinalVariableName"/>

        <!-- Стандарты тестов. Аннотации разбираются по IDENT внутри ANNOTATION:
             MatchXpath не умеет адресоваться к атрибутам через @text у узла-аннотации.
             Каждое правило обязано нести message: без неё нарушитель видит
             безликое «MatchXpath: XPath query matched» и не понимает требование. -->
        <module name="MatchXpath">
            <property name="id" value="TestMethodNamingConvention"/>
            <property name="query"
                      value="//METHOD_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='RepeatedTest']][IDENT[not(matches(@text, '^[a-z][a-zA-Z0-9]*_[a-zA-Z0-9]+_[a-zA-Z0-9]+$'))]]"/>
            <message key="matchxpath.match"
                     value="Тестовый метод должен называться method_condition_outcome: ровно три сегмента через _."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="RequireDisplayNameOnTests"/>
            <property name="query"
                      value="//METHOD_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='RepeatedTest']][not(MODIFIERS/ANNOTATION/IDENT[@text='DisplayName'])]"/>
            <message key="matchxpath.match"
                     value="Тестовому методу нужен @DisplayName, описывающий сценарий."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="GivenWhenThenStructure"/>
            <property name="query"
                      value="//METHOD_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='RepeatedTest']][not(.//COMMENT_CONTENT[contains(@text, 'given')]) or not(.//COMMENT_CONTENT[contains(@text, 'when')]) or not(.//COMMENT_CONTENT[contains(@text, 'then')])]"/>
            <message key="matchxpath.match"
                     value="Тестовый метод должен содержать комментарии // given, // when, // then."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="JUnit5PackagePrivate"/>
            <property name="query"
                      value="//METHOD_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='RepeatedTest']][MODIFIERS/LITERAL_PUBLIC]"/>
            <message key="matchxpath.match"
                     value="Тестовые методы — package-private: JUnit 5 не требует public, публичность скрывает API-назначение."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="NoSpringContextInUnitTests"/>
            <property name="query"
                      value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='SpringBootTest']][IDENT[matches(@text, 'Test$')]]"/>
            <message key="matchxpath.match"
                     value="@SpringBootTest допустим только в классах *IT (failsafe); юнит-тесты (*Test) работают без контекста Spring."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="TestClassSuffix"/>
            <property name="query"
                      value="//CLASS_DEF[not(IDENT[matches(@text, '(Test|IT)$')])][.//METHOD_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='RepeatedTest']]]"/>
            <message key="matchxpath.match"
                     value="Класс, содержащий @Test-методы, должен называться XxxTest (surefire) или XxxIT (failsafe)."/>
        </module>

        <!-- Архитектура Spring: поле-инъекция прячет зависимости и требует
             контекста для unit-теста — только конструктор + final-поля.
             Для src/test отключено в suppressions.xml (@Autowired на полях —
             идиома Spring Test). -->
        <module name="MatchXpath">
            <property name="id" value="NoFieldInjection"/>
            <property name="query"
                      value="//VARIABLE_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Autowired' or @text='Inject']]"/>
            <message key="matchxpath.match"
                     value="Field injection запрещен: используй конструктор и final-поля."/>
        </module>

        <!-- Транзакция на весь сервис открывается и на методах чтения, и на
             внешних вызовах. readOnly = true — исключение: это явный контракт
             «только чтение», а не случайная широкая транзакция. -->
        <module name="MatchXpath">
            <property name="id" value="NoClassLevelTransactional"/>
            <property name="query"
                      value="//CLASS_DEF[MODIFIERS/ANNOTATION[IDENT[@text='Transactional'] and not(ANNOTATION_MEMBER_VALUE_PAIR[IDENT[@text='readOnly']]/EXPR/LITERAL_TRUE)]]"/>
            <message key="matchxpath.match"
                     value="@Transactional на классе запрещён: аннотируй метод. Для read-only сервиса допустимо @Transactional(readOnly = true)."/>
        </module>

        <!-- Ограничение сложности: разбивай ветвление на приватные методы
             с говорящими именами, а не держи логику в одном «спагетти»-методе. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <!-- Максимум 3 логических/сравнительных оператора в одном выражении:
             сложное условие выносится в именованный предикат. -->
        <module name="BooleanExpressionComplexity">
            <property name="max" value="3"/>
        </module>
        <!-- Arrow anti-pattern: guard clauses вместо матрёшки if/for/try. -->
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="1"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="50"/>
            <property name="countEmpty" value="false"/>
        </module>
        <!-- Анонимный класс длиннее 25 строк — это почти всегда скрытый
             отдельный класс, который нужно вынести. -->
        <module name="AnonInnerLength">
            <property name="max" value="25"/>
        </module>
        <!-- Больше 5 признаков — признак того, что пора ввести DTO/запрос-объект. -->
        <module name="ParameterNumber">
            <property name="max" value="5"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
        <module name="ExecutableStatementCount">
            <property name="max" value="30"/>
        </module>
        <!-- Слишком много зависимостей от классов из других пакетов —
             God Object. Constructor injection через Lombok не виден AST как
             параметры метода, поэтому ограничиваем связность по типам. -->
        <module name="ClassDataAbstractionCoupling">
            <property name="max" value="10"/>
        </module>
        <!-- Метод-«решето» из return: максимум 4 выхода, включая void-методы. -->
        <module name="ReturnCount">
            <property name="max" value="4"/>
            <property name="maxForVoid" value="4"/>
        </module>

        <!-- Гигиена исключений: catch (Exception/Throwable/RuntimeException)
             маскирует реальную причину отказа. Лови конкретные типы; генеральный
             перехват допустим только там, где политика — «любой сбой внешнего
             клиента = доменный отказ» (маппинг исключений в исключения проекта). -->
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Exception, java.lang.Throwable, java.lang.RuntimeException, java.lang.NullPointerException"/>
        </module>
        <!-- throws Exception/Throwable/RuntimeException/Error — признак ленивой
             контрактной модели: checked-исключения нужно оборачивать в доменные.
             Исключение — Security DSL (SecurityFilterChain/AuthenticationManager),
             там throws Exception задан API Spring Security; см. suppressions.xml. -->
        <module name="IllegalThrows">
            <property name="illegalClassNames"
                      value="java.lang.Throwable, java.lang.RuntimeException, java.lang.Error, java.lang.Exception"/>
        </module>

        <!-- Магическое число в теле метода: вынеси в private static final
             с говорящим именем. Объявления полей и аннотации не считаются —
             там числовые константы легитимны. -->
        <module name="MagicNumber">
            <property name="ignoreFieldDeclaration" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreNumbers" value="-1,0,1,2"/>
        </module>

        <!-- Чистота логики: параметры не мутируются (предсказуемость),
             null-безопасные equals, стабильный контрол-переменный цикла,
             имена локальных/полей не перекрываются без нужды. -->
        <module name="ParameterAssignment"/>
        <module name="EqualsAvoidNull"/>
        <module name="ModifiedControlVariable"/>
        <module name="HiddenField">
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
            <property name="setterCanReturnItsClass" value="true"/>
        </module>

        <!-- Незакомментированный пустой catch — «черная дыра»: либо имя expected|ignore,
             либо объяснение внутри тела. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
        </module>

        <!-- TODO/FIXME — это незакрытый долг: реализуй сейчас или заведи задачу
             во внешнем трекере без пометки в коде. -->
        <module name="TodoComment">
            <property name="format" value="(?i)(TODO|FIXME)"/>
        </module>

        <!-- Дизайн и модификаторы -->
        <module name="FinalClass"/>
        <!-- Utility-классу нужен приватный конструктор. Жёсткий список имён
             хрупок (новый @Configuration/@Mapper валит сборку), поэтому
             подавление — по аннотации через XPath: Spring-бины создаёт контейнер,
             MapStruct-интерфейсы — генератор, приватный конструктор им не нужен. -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="HideUtilityClassConstructor"/>
            <property name="query"
                      value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='SpringBootApplication' or @text='Configuration' or @text='Component' or @text='Mapper']] | //INTERFACE_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Mapper']]"/>
        </module>
        <module name="HideUtilityClassConstructor"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>

        <!-- Структура кода -->
        <module name="NeedBraces"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="EmptyStatement"/>
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_TRY"/>
        </module>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <!-- Пробелы (базовые; полное форматирование — Spotless) -->
        <module name="GenericWhitespace"/>
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI, TYPECAST"/>
        </module>
        <module name="WhitespaceAround">
            <property name="allowEmptyTypes" value="false"/>
            <property name="allowEmptyConstructors" value="false"/>
            <property name="allowEmptyLambdas" value="false"/>
            <property name="allowEmptyMethods" value="false"/>
            <property name="allowEmptyLoops" value="false"/>
        </module>

        <!-- Наследование и equals/hashCode -->
        <module name="EqualsHashCode"/>
        <module name="SuperFinalize"/>

    </module>
</module>
