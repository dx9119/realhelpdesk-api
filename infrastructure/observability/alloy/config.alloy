// Alloy: скрейп метрик приложения → Mimir.
//
// Приложение запущено НА ХОСТЕ (make run-local), поэтому метрики берутся с
// host.docker.internal:<management.port> — extra_hosts с host-gateway объявлен
// для сервиса alloy в docker-compose.obs.yaml.
//
// Логи приложения alloy НЕ собирает: хостовый процесс пишет их в stdout
// запускающего терминала (в CI — в лог шага), контейнера с логами нет. Логи
// приложения — текстовый паттерн logback-spring.xml c колонками
// traceId/spanId, поэтому ссылка на трейс строится по 32-символьному traceId.
//
// Метрики: скрейпит управляющий порт приложения (management.server.port, HTTP Basic
// сервисной учёткой METRICS_USER/METRICS_PASSWORD — те же креды, что проверяются
// в ActuatorSecurityTest) и шлёт remote_write в distributor Mimir.

logging {
  level = "info"
}

// Скрейп метрик: приложение на хосте — target host.docker.internal:8081
// (управляющий порт; host-gateway резолвится через extra_hosts сервиса alloy).
prometheus.scrape "app" {
  targets = [{
    "__address__"      = "host.docker.internal:8081",
    "__metrics_path__" = "/actuator/prometheus",
  }]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  // Метка job — как у прежнего Prometheus (job_name: realhelpdesk): алерт
  // AppUnreachable (up{job="realhelpdesk"} == 0) и runbook фильтруются по ней.
  job_name = "realhelpdesk"

  basic_auth {
    username = sys.env("METRICS_USER")
    password = sys.env("METRICS_PASSWORD")
  }

  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:8090/api/v1/push"
  }
}
