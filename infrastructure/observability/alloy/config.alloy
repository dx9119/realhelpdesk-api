// Alloy: сбор логов приложения из docker json-file → Loki
// и скрейп метрик приложения → remote_write в Mimir.
//
// Логи: наследник Promtail — тянет только контейнер сервиса app (фильтр по compose-метке),
// чтобы postgres/mimir/k6 не засоряли индекс. Логи приложения — текстовый паттерн
// logback-spring.xml c колонками traceId/spanId (шаг 7), поэтому ссылка на трейс
// строится по 32-символьному traceId в LogQL-запросах.
//
// Метрики: скрейпит управляющий порт приложения (management.server.port, HTTP Basic
// сервисной учёткой METRICS_USER/METRICS_PASSWORD — те же креды, что проверяются
// в ActuatorSecurityTest) и шлёт remote_write в distributor Mimir.
//
// Важно: discovery.docker отдаёт метки вида __meta_docker_* — без relabel_rules они не
// становятся stream-метками Loki (логи приходят как unknown_service без container).

logging {
  level = "info"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.service=app"]
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container_label_com_docker_compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Скрейп метрик: один target — app:8081 (управляющий порт в той же сети compose).
prometheus.scrape "app" {
  targets = [{
    "__address__"      = "app:8081",
    "__metrics_path__" = "/actuator/prometheus",
  }]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  // Метка job — как у прежнего Prometheus (job_name: realhelpdesk): алерт
  // AppUnreachable (up{job="realhelpdesk"} == 0) и runbook фильтруются по ней.
  job_name = "realhelpdesk"

  basic_auth {
    username = sys.env("METRICS_USER")
    password = sys.env("METRICS_PASSWORD")
  }

  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:8090/api/v1/push"
  }
}
