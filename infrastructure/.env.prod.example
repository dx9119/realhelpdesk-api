# ===========================================================================
# Шаблон рабочего контура (make prod-up): заполните секреты и укажите
# внешние сервисы.
#
#   scp .env.prod.example user@host:/opt/app/infrastructure/.env
#   make prod-up
# ===========================================================================

# ===========================================================================
# Секреты: заполните все, генерация — openssl rand -base64 32.
# ===========================================================================

# Секрет подписи и проверки JWT (HS256, base64, минимум 32 байта).
JWT_SECRET=

# HMAC-секрет подписи challenge и токенов капчи (PoW); минимум 32 символа.
CAPTCHA_HMAC_SECRET=

# Пароль PostgreSQL.
DB_PASSWORD=

# Пароль от SMTP.
MAIL_PASSWORD=

# Пароль keystore. Монтируется реальный сертификат в /app/ssl/keystore.p12.
KEY_STORE_PASS=

# Учётные данные root-пользователя MinIO (файлы вложений заявок).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Пароль сервисной учётки HTTP Basic для /actuator/prometheus.
METRICS_PASSWORD=

# ===========================================================================
# База данных: основная PostgreSQL.
# ===========================================================================
DB_URL=${DB_URL:-jdbc:postgresql://postgres:5432/desk?reWriteBatchedInserts=true}

# ===========================================================================
# MinIO: хранилище файлов вложений заявок.
# ===========================================================================
MINIO_ENDPOINT=http://minio:9000

# ===========================================================================
# JWT: домены выдачи и CORS.
# ===========================================================================
JWT_ISSUER=https://app.example.com
JWT_AUDIENCE=https://app.example.com
# Origin'ы продового фронта, через запятую; localhost недопустим (preflight).
CORS_ALLOWED_ORIGINS=https://app.example.com

# ===========================================================================
# Продукт: название, адреса писем, адрес раздачи файлов.
# ===========================================================================
APP_NAME=Real help desk
APP_PROJECT_NAME=real help desk
MAIL_FROM=noreply@example.com
MAIL_NOTIFY=admin@example.com
# Публичный адрес раздачи файлов; пусто — ссылки относительные, файлы отдаёт API.
STATIC_BASE_URL=

# ===========================================================================
# Почта: SMTP-сервер окружения.
# ===========================================================================
# Внешний почтовый сервер.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true

# Домен фронта в письмах.
FRONT_DOMAIN=app.example.com

# ===========================================================================
# JWT: cookie (SameSite=Lax обязателен без внешнего Keycloak).
# ===========================================================================
# Общий домен cookie для поддоменов; пусто — host-only cookie.
#JWT_COOKIE_DOMAIN=.example.com

# ===========================================================================
# Капча: в рабочем контуре обязательна (старт без неё валит prod-preflight).
# ===========================================================================
CAPTCHA_ENABLED=true
# Минимум секунд от выдачи задания до отправки формы (дефолт схемы 0; для контура рекомендуется 3).
#CAPTCHA_MIN_FILL_SECONDS=3

# ===========================================================================
# Reverse-proxy (nginx/traefik на этом же хосте):
# читать X-Forwarded-For и класть его в логи и рейт-лимит.
#TRUST_PROXY_HEADERS=true
#CLIENT_IP_FORWARDED_INDEX=-1

# ===========================================================================
# Внешний Keycloak (если профиль prod,keycloak).
# ===========================================================================
# Если приложение использует внешний Keycloak, укажите его адреса.
#KC_JWK_SET_URI=http://keycloak.example.com/realms/realhelpdesk/protocol/openid-connect/certs
#KC_ISSUER_URI=http://keycloak.example.com/realms/realhelpdesk

# ===========================================================================
# JVM: диагностика и память.
# ===========================================================================
JAVA_JFR_OPTS=
JAVA_HEAP_DUMP_OPTS=
JAVA_NMT_OPTS=
JAVA_JMX_OPTS=
JAVA_XMX=
JAVA_RAM_PERCENTAGE=45
