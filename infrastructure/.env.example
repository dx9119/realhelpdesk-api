# ===========================================================================
# Единственный env-шаблон проекта: секреты, конфигурация приложения и
# настройки инфраструктуры compose.
#
#   cp infrastructure/.env.example infrastructure/.env   # делает make env
#
# Рабочий файл infrastructure/.env в git не попадает. Он работает в двух
# ролях одновременно:
#   1) env_file контейнеров (app, alloy) — весь несекретный набор и секреты;
#   2) источник ${VAR}-интерполяции infrastructure/docker-compose.yaml.
# Поэтому различия сред (пароли, порты, URL, SPRING_PROFILES_ACTIVE) живут
# здесь, а не в compose-файлах: один compose-файл + профили, всё остальное —
# в .env конкретной машины.
#
# make env существующий .env не затирает: недостающие из шаблона ключи
# дописываются, ваши значения сохраняются.
#
# Профили единого infrastructure/docker-compose.yaml:
#   infra      — postgres, minio: внутренняя сеть data (internal), портов на хост нет
#   dev        — smtp4dev, db-gateway и keycloak (хостовые 127.0.0.1:5432/9000/9001/8180)
#   app        — приложение
#   monitoring — mimir, grafana, tempo, loki, otel-collector, alloy
#   load       — k6
# make up поднимает infra+dev+app, make up-prod — infra+app (без dev и
# monitoring), make obs-up — + monitoring.
#
# Профиль приложения keycloak (SPRING_PROFILES_ACTIVE ниже) включает
# OAuth2 Resource Server: токены выпускает сервис keycloak, приложение только
# проверяет подпись по JWK и читает email/realm-роли из токена. Без профиля
# keycloak работает внутренний JWT-контур приложения (cookie, /api/v1/auth/*).
# Сервис keycloak живёт в профиле dev, поэтому make up-prod поднимает
# приложение уже без Keycloak — там его нужно указывать на внешний сервер.
#
# Схема обязательных ключей приложения — src/main/resources/application.properties
# (только ${VAR} без дефолтов); парность с этим файлом и с services.app.environment
# в infrastructure/docker-compose.yaml сверяет ApplicationConfigSchemaTest.
# Ключи KC_*/KEYCLOAK_* в схему не входят: они читаются профильным
# application-keycloak.properties и сервисом keycloak, а не базовой схемой.
#
# Три ключа управляются compose-интерполяцией (services.app.environment),
# поэтому здесь они НЕ объявлены — задаются только при необходимости:
#   OTLP_TRACING_ENDPOINT   дефолт http://localhost:4317; make obs-up передаёт
#                           адрес collector'а инлайном, постоянно — раскомментируйте ниже
#   TRUST_PROXY_HEADERS     дефолт false; make up-load передаёт true инлайном
#   CLIENT_IP_FORWARDED_INDEX дефолт 0
#
# Интерполяция: ${VAR} и ${VAR:-default} внутри значений читаются из окружения
# compose (infrastructure/.env и переменные хоста). Правило про $: значение
# читается до попадания в контейнер, поэтому pa$sword станет pa — экранируйте
# как p$$ss. Строки в кавычки брать не нужно, но # внутри значения не работает:
# всё после # считается комментарием.

# ===========================================================================
# Секреты: заполните пустые значения, генерация — openssl rand -base64 32.
# ===========================================================================

# Секрет подписи и проверки JWT (HS256, base64, минимум 32 байта).
JWT_SECRET=

# HMAC-секрет подписи challenge и токенов капчи (PoW); минимум 32 символа.
# prod-preflight отвергает пустое и короткое значение, а также значение
# с префиксом dev-only из инструкций ниже.
CAPTCHA_HMAC_SECRET=

# Пароль PostgreSQL (общий для приложения и postgres-сервиса).
DB_PASSWORD=

# Необязательные переопределения инфраструктуры compose (дефолты user/desk):
#POSTGRES_USER=user
#POSTGRES_DB=desk

# Пароль от SMTP. Локальному smtp4dev аутентификация не нужна (пусто);
# рабочему SMTP — пароль учетной записи MAIL_USER (см. секцию «Рабочий контур»).
MAIL_PASSWORD=

# Пароль keystore. Keystore генерируется при старте контейнера,
# поэтому смена пароля не требует пересборки: поправить infrastructure/.env и
#   make restart
KEY_STORE_PASS=demo-keystore-pass

# Учётные данные root-пользователя MinIO (файлы вложений заявок): их же
# приложение получает как MINIO_ACCESS_KEY/MINIO_SECRET_KEY. Пустое значение
# обязательной переменной валит compose на старте.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Пароль сервисной учётки HTTP Basic для /actuator/prometheus на управляющем
# порту (8081). Имя пользователя — METRICS_USER (секция «Наблюдаемость»).
# Пустое значение валит compose на старте — скрейп без пароля закрыт.
METRICS_PASSWORD=

# Начальный администратор Keycloak (профиль приложения keycloak, сервис
# keycloak). Создаётся только при пустой БД Keycloak; имя — KEYCLOAK_ADMIN
# (дефолт admin). Пароль необязателен: сервис живёт в профиле dev и слушает
# loopback, поэтому при пустом значении стенд поднимается с дефолтным admin —
# заполните, если стенд доступен не только вам.
KEYCLOAK_ADMIN_PASSWORD=

# Учётные данные администратора Grafana (make obs-up).
# Пароль по умолчанию admin — задайте свой; пользователь admin.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=
# Порт Grafana на хосту (дефолт 3001: 3000 обычно занят dev-сервером фронтенда).
#GRAFANA_PORT=3001

# Порт API MinIO на хосту (по умолчанию 9000); UI контейнера — 127.0.0.1:9001.
# Оба публикует db-gateway (профиль dev) на loopback; сам minio портов на хост
# не имеет. Приложению порт не нужен: оно ходит во внутреннюю сеть http://minio:9000.
#MINIO_API_PORT=9000

# ===========================================================================
# Продукт: лимиты, капча, сроки токенов, название и адреса писем.
# ===========================================================================

# --- Rate limit: пороги (число запросов / окно в секундах) ---
# Ключ должен совпадать с key в аннотации @RateLimit на методе контроллера.
# Берёт ли приложение IP клиента из заголовков прокси — см. блок
# «Клиентский IP» ниже (включать только за прокси).
RATE_LIMIT_AUTH_REGISTER_REQUESTS=10
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_LOGIN_REQUESTS=10
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_ACCESS_TOKEN_REQUESTS=30
RATE_LIMIT_AUTH_ACCESS_TOKEN_WINDOW_SECONDS=300
RATE_LIMIT_CAPTCHA_CHALLENGE_REQUESTS=30
RATE_LIMIT_CAPTCHA_CHALLENGE_WINDOW_SECONDS=60
RATE_LIMIT_CAPTCHA_SOLVE_REQUESTS=30
RATE_LIMIT_CAPTCHA_SOLVE_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_REQUEST_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=600
RATE_LIMIT_PASSWORD_RESET_CONFIRM_REQUESTS=5
RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=600
RATE_LIMIT_EMAIL_CODE_REQUESTS=3
RATE_LIMIT_EMAIL_CODE_WINDOW_SECONDS=600
# Лимит писем восстановления пароля на один адрес (окно 86400 сек = 24 часа)
RATE_LIMIT_EMAIL_RECOVERY_REQUESTS=3
RATE_LIMIT_EMAIL_RECOVERY_WINDOW_SECONDS=86400
# Long polling оповещений: 30 подключений в минуту на IP — вкладка держит
# один запрос ~25 сек (около 2.4 в минуту), запас на переподключения
RATE_LIMIT_NOTIFICATIONS_WAIT_REQUESTS=30
RATE_LIMIT_NOTIFICATIONS_WAIT_WINDOW_SECONDS=60
# Передача портала: initiate (инициатор) и confirm (новый владелец) — с паролем
RATE_LIMIT_PORTAL_TRANSFER_REQUEST_REQUESTS=5
RATE_LIMIT_PORTAL_TRANSFER_REQUEST_WINDOW_SECONDS=300
RATE_LIMIT_PORTAL_TRANSFER_CONFIRM_REQUESTS=5
RATE_LIMIT_PORTAL_TRANSFER_CONFIRM_WINDOW_SECONDS=300

# --- Капча ---
# Локальная разработка: выключена (отладка форм). Для рабочего контура
# раскомментируйте CAPTCHA_ENABLED=true в секции «Рабочий контур» —
# prod-preflight (ProdPreflightValidator) валит старт с выключенной капчей.
CAPTCHA_ENABLED=false
# Сложность Proof-of-Work — число ведущих нулевых бит SHA-256: клиент решает
# за ~2^N хэшей; prod-рекомендация — 18–20.
CAPTCHA_POW_DIFFICULTY=18
# Срок жизни challenge (до решения) и выданного токена (до отправки формы), сек.
CAPTCHA_CHALLENGE_TTL_SECONDS=300
CAPTCHA_TOKEN_TTL_SECONDS=300
# Минимальное время от выдачи challenge до отправки формы, сек: отсекает
# автоотправку, людям не мешает. 0 — локально, 3 — в «Рабочем контуре».
CAPTCHA_MIN_FILL_SECONDS=0
# Эскалация по риску (локальный риск-движок, без внешних провайдеров). Сигналы
# разделены, чтобы NAT-сеть с одним внешним адресом не блокировалась из-за
# провалов отдельных клиентов:
#   - провалы одного IP (CAPTCHA_RISK_FAILURE_THRESHOLD за окно
#     CAPTCHA_RISK_FAILURE_WINDOW_SECONDS) — только мягкий риск: к сложности
#     PoW добавляется CAPTCHA_RISK_ELEVATED_DIFFICULTY_BONUS бит;
#   - провалы CAPTCHA_RISK_SUBNET_OFFENDER_THRESHOLD разных IP одной подсети —
#     признак распределённой атаки: вместо PoW выдаётся эмодзи-задание.
# Эскалация выключается флагом CAPTCHA_EMOJI_ENABLED=false.
CAPTCHA_EMOJI_ENABLED=true
CAPTCHA_RISK_FAILURE_THRESHOLD=5
CAPTCHA_RISK_FAILURE_WINDOW_SECONDS=600
# Мягкий риск: к базовой сложности PoW добавляется столько бит (не выше 26).
CAPTCHA_RISK_ELEVATED_DIFFICULTY_BONUS=3
CAPTCHA_RISK_SUBNET_OFFENDER_THRESHOLD=3
CAPTCHA_RISK_SUBNET_PREFIX_V4=24
CAPTCHA_RISK_SUBNET_PREFIX_V6=64

# --- JWT: сроки жизни и cookie ---
# Все сроки жизни токенов — в секундах (легко задать маленькие значения для проверок).
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
# Ротация refresh-токенов в БД: задача удаляет отозванные строки jwt_tokens
# (логаут, смена пароля, ротация при входе) старше JWT_REVOKED_TOKEN_RETENTION_SECONDS
# и активные строки старше срока жизни токена (JWT_REFRESH_TOKEN_EXPIRATION_SECONDS).
# Удаление идёт батчами (размер адаптируется в границах MIN..MAX по времени
# батча относительно TARGET_MS) с паузой PAUSE_MS между батчами — без пиков на БД.
# Расписание — cron из 6 полей (сек мин час день месяц день-недели).
JWT_REVOKED_TOKEN_RETENTION_SECONDS=604800
JWT_TOKEN_CLEANUP_CRON=0 30 3 * * *
JWT_TOKEN_CLEANUP_BATCH_MIN_SIZE=100
JWT_TOKEN_CLEANUP_BATCH_MAX_SIZE=5000
JWT_TOKEN_CLEANUP_TARGET_BATCH_MS=200
JWT_TOKEN_CLEANUP_BATCH_PAUSE_MS=50
# SameSite: весь допустимый набор — None, Lax, Strict (enum SameSite в коде);
# регистр не важен, любое другое значение останавливает старт приложения.
# Локально None — cross-site cookie для отладки в браузере; без JWT_COOKIE_DOMAIN
# допустимо только в dev (prod-preflight требует для None домен, поэтому в
# секции «Рабочий контур» SameSite=Lax).
JWT_COOKIE_SAMESITE=None
# Домен cookie: пусто — cookie только для своего хоста (host-only); .example.com —
# общий для поддоменов, нужен, когда файлы отдаёт отдельный домен (STATIC_BASE_URL).
JWT_COOKIE_DOMAIN=

# --- Операторы: назначение ROLE_OPERATOR ---
# Список email через запятую. При старте приложения эти пользователи (только уже
# зарегистрированные и с подтверждённым email) повышаются до ROLE_OPERATOR. Список
# только повышает: удаление адреса роль не снимает (снимайте вручную в БД).
APP_OPERATOR_EMAILS=

# --- Название и почтовые адреса ---
# MAIL_FROM и MAIL_NOTIFY — домены из application-domains.properties.
APP_NAME=Real help desk
APP_PROJECT_NAME=real help desk
MAIL_FROM=noreply@example.com
MAIL_NOTIFY=admin@example.com

# --- JPA: архитектурное решение, не зависит от окружения ---
JPA_OSIV=false

# --- MinIO: файлы вложений заявок ---
# Имя бакета; создаётся автоматически при первом обращении приложения.
MINIO_BUCKET=realhelpdesk-attachments

# --- Статический контент: отдельный origin для файлов ---
# Публичный адрес раздачи файлов (домен или ip:port) — из него API собирает
# downloadUrl в ответах; пусто — ссылки относительные, файлы отдаёт сам API.
STATIC_BASE_URL=
# Cache-Control для отдачи файлов: значение уходит в заголовок как есть.
STATIC_CACHE_CONTROL=private, no-store

# --- Multipart-загрузка файлов ---
# Лимит на один файл и на весь запрос (формат DataSize: 20MB, 512kB, 1g).
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=25MB

# ===========================================================================
# Приложение: профиль и сервер.
# ===========================================================================

# dev — локальная отладка (подробно, с SQL); prod — рабочий контур.
# Профили меняют только уровни логирования (application-*.properties).
#
# keycloak — внешний выпуск токенов (OAuth2 Resource Server, сервис keycloak
# профиля dev): так стек работает по умолчанию. Без keycloak включается
# внутренний JWT-контур приложения (cookie, /api/v1/auth/*). Профиль
# keycloak — второй, а не самостоятельный: он добавляет свои ключи к
# базовому dev/prod (application-keycloak.properties).
#
# Внутренний JWT-контур (e2e-сценарии scripts/e2e-*.sh, нагрузка k6):
#SPRING_PROFILES_ACTIVE=dev
SPRING_PROFILES_ACTIVE=dev,keycloak

SERVER_PORT=8443
KEY_STORE_PATH=file:/app/ssl/keystore.p12
KEY_STORE_TYPE=PKCS12
# Keystore генерируется при старте контейнера (scripts/docker/entrypoint.sh),
# если свой файл не смонтирован в /app/ssl/keystore.p12. Prod-preflight
# отвергает самоподписанный CN=localhost в рабочем контуре.
KEY_STORE_ALIAS=tomcat

# ===========================================================================
# Keycloak: внешний выпуск токенов (профиль приложения keycloak, сервис keycloak).
# ===========================================================================
# Профиль включается в SPRING_PROFILES_ACTIVE выше (dev,keycloak). Значения
# ниже читает application-keycloak.properties — в схему базового
# application.properties они не входят.
#
# KC_JWK_SET_URI — адрес публичных ключей Keycloak, по нему приложение
# проверяет подпись токена. Запрос идёт из контейнера app, поэтому адрес —
# внутренний (имя сервиса compose keycloak и его порт 8080), а не localhost
# с хостовым портом.
KC_JWK_SET_URI=http://keycloak:8080/realms/realhelpdesk/protocol/openid-connect/certs
# KC_ISSUER_URI — ожидаемое значение claim iss. Оно должно совпадать с
# KC_HOSTNAME ниже: тот адрес Keycloak кладёт в токен (его видит браузер),
# а сетевой доступ к issuer не нужен — при заданном jwk-set-uri приложение
# только сверяет строку claim.
KC_ISSUER_URI=http://localhost:8180/realms/realhelpdesk
# KC_HOSTNAME — адрес Keycloak, видимый браузеру: страница входа, ссылки и iss
# токена. Внутри стека это 127.0.0.1:8180 (порт публикует сервис keycloak).
KC_HOSTNAME=http://localhost:8180
# Хостовый порт Keycloak (дефолт 8180: 8080 обычно занят другими стендами).
KEYCLOAK_PORT=8180
# Имя начального администратора Keycloak (пароль — секрет в секции «Секреты»);
# учётка создаётся только при пустой базе Keycloak.
KEYCLOAK_ADMIN=admin
# Отдельная база Keycloak в том же PostgreSQL (её создаёт сервис keycloak-db-init).
# Схему приложения миграции Liquibase не касаются — базы разные.
KEYCLOAK_DB=keycloak

# ===========================================================================
# База данных: основная PostgreSQL.
# ===========================================================================
# Имя БД и пользователь postgres-сервиса задаются в compose (POSTGRES_USER/POSTGRES_DB,
# дефолты user/desk, переопределяются здесь же) — приложение ходит в БД
# по DB_URL/DB_USER ниже.

# Подключение приложения: по умолчанию — основная БД внутри compose-сети.
# reWriteBatchedInserts=true — batch-инсерты (EmailLog, attachments) реально
# батчатся на стороне драйвера PostgreSQL.
# Запуск приложения из IDE на хосту: DB_URL должен смотреть на
# localhost:5432 — порт публикует db-gateway (профиль dev) на 127.0.0.1.
DB_URL=${DB_URL:-jdbc:postgresql://postgres:5432/desk?reWriteBatchedInserts=true}
DB_USER=user

# ===========================================================================
# Миграции схемы (Liquibase).
# ===========================================================================
# Структуру создаёт changelog src/main/resources/db/changelog, Hibernate
# в validate только сверяет entity с ней. Изменения структуры — новый
# changeset, а не правка руками.
# Префикс DB_MIGRATIONS_, а не LIQUIBASE_: Liquibase 5 сам читает LIQUIBASE_*
# из окружения и warns об этих именах как о «невалидных».
DB_MIGRATIONS_ENABLED=true
DB_MIGRATIONS_CHANGE_LOG=classpath:db/changelog/db.changelog-master.xml

# ===========================================================================
# Распределённая трассировка OpenTelemetry.
# ===========================================================================
# Доля запросов, попадающих в трейс: 1.0 — локальная отладка (dev), 0.1 — prod.
TRACING_SAMPLING_PROBABILITY=1.0

# Версия сервиса для resource-атрибута service.version в спанах (дефолт совпадает с pom.xml).
OTEL_SERVICE_VERSION=0.0.1-SNAPSHOT

# OTLP-экспортёр задаётся compose-интерполяцией (см. шапку). Постоянный адрес
# collector'а для make obs-up — раскомментируйте (заменяет дефолт localhost:4317):
#OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# ===========================================================================
# JPA/Hibernate.
# ===========================================================================
# Режим ddl-auto задан в коде (application.properties, validate) и окружением
# не управляется — так изменяющий схему режим нельзя вернуть ни из env-файлов,
# ни из infrastructure/.env. show-sql/format-sql — отладочный вывод SQL.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# ===========================================================================
# JWT: домены выдачи (схема — application-domains.properties).
# ===========================================================================
# issuer/audience пишутся в токены и сверяются при валидации. Секрет — в секции
# «Секреты», сроки жизни и cookie — в секции «Продукт».
JWT_ISSUER=https://example.com
JWT_AUDIENCE=https://example.com
# Origin'ы фронта для CORS, список через запятую (см. cors.allowed-origins).
# Локальные origin'ы — здесь; без localhost для рабочего контура —
# в секции «Рабочий контур» (prod-preflight отвергает localhost).
CORS_ALLOWED_ORIGINS=https://localhost.ru,https://example.com

# ===========================================================================
# Почта: SMTP-сервер окружения.
# ===========================================================================
# Локально — smtp4dev (сервис профиля dev, UI на http://localhost:3000):
# без аутентификации, порт 25. Рабочий внешний SMTP задаётся в секции
# «Рабочий контур». Профиль prod проверяет это же preflight-ом: MAIL_HOST не
# localhost/127.0.0.1/«smtp», MAIL_PORT — число 1–65535, MAIL_FROM обязателен,
# при SMTP_AUTH=true нужен MAIL_USER.
MAIL_PROTOCOL=smtp
MAIL_HOST=smtp
MAIL_PORT=25
MAIL_USER=user@example.com
SMTP_AUTH=false
SMTP_STARTTLS=false
# Таймауты SMTP (мс): установка соединения, чтение ответа сервера, запись.
# Мёртвый SMTP не держит ни отправку, ни health-проверку дольше этих пределов.
MAIL_SMTP_CONNECTION_TIMEOUT=3000
MAIL_SMTP_READ_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000

# Домен фронта в письмах (email.domain) — зависит от окружения.
FRONT_DOMAIN=front.example.ru

# ===========================================================================
# Клиентский IP (логи и ключ рейт-лимита) — см. ClientIpProperties.
# ===========================================================================
# TRUST_PROXY_HEADERS и CLIENT_IP_FORWARDED_INDEX задаются compose-интерполяцией
# (см. шапку): дефолты false/0; за прокси и при нагрузочном тестировании —
# раскомментируйте ниже или задайте в infrastructure/.env.
#TRUST_PROXY_HEADERS=true
#CLIENT_IP_FORWARDED_INDEX=-1

# Заголовки в порядке приоритета (через запятую): берётся первый, из которого
# удалось извлечь адрес. Распространённые: X-Forwarded-For (nginx, HAProxy),
# X-Real-IP (nginx), CF-Connecting-IP (Cloudflare), True-Client-IP (Akamai),
# X-Client-IP, Proxy-Client-IP / WL-Proxy-Client-IP (WebLogic),
# Forwarded (RFC 7239, вида for=1.2.3.4;proto=https).
CLIENT_IP_HEADERS=X-Forwarded-For,X-Real-IP,CF-Connecting-IP,True-Client-IP,X-Client-IP,Proxy-Client-IP,WL-Proxy-Client-IP,Forwarded

# ===========================================================================
# MinIO: хранилище файлов вложений заявок.
# ===========================================================================
# Адрес — имя сервиса compose (внутренняя сеть data, не localhost). Учётки
# совпадают с root-ом MinIO и приходят из секции «Секреты» (в compose —
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY), имя бакета — в секции «Продукт».
MINIO_ENDPOINT=http://minio:9000

# ===========================================================================
# Наблюдаемость: управляющий порт и скрейп метрик.
# ===========================================================================
# Порт actuator (health/info/prometheus) — отдельный от приложения, поэтому
# метрики и пробы не публикуются на SERVER_PORT. Пробросывается на хост только
# на loopback (127.0.0.1:8081, infrastructure/docker-compose.yaml); пароль
# скрейпа — секрет METRICS_PASSWORD из секции «Секреты».
MANAGEMENT_PORT=8081
# С адресом по умолчанию (все интерфейсы) управляющий порт слышен во внутренней
# сети compose — так скрейп (alloy) и дашборды достают метрики из контейнера.
MANAGEMENT_ADDRESS=0.0.0.0
# Сервисный пользователь HTTP Basic для /actuator/prometheus (пароль — METRICS_PASSWORD)
METRICS_USER=prometheus

# ===========================================================================
# JVM: диагностика и память (перекрывают ENV образа).
# ===========================================================================
# Диагностика по умолчанию выключена (sec.md §7.8): пустое JAVA_* означает
# «не добавлять флаг», включение — ненулевое значение здесь же (entrypoint
# передаёт его в JVM). GC-логи всегда пишутся в stderr (образ, п. 6) —
# попадают в docker logs без файлов на диске. Пустое JAVA_XMX переключает
# entrypoint на -XX:MaxRAMPercentage, то есть heap масштабируется вместе с
# mem_limit (45% от 768m ≈ 345M).
JAVA_JFR_OPTS=
JAVA_HEAP_DUMP_OPTS=
JAVA_NMT_OPTS=
JAVA_JMX_OPTS=
JAVA_XMX=
JAVA_RAM_PERCENTAGE=45

# ===========================================================================
# Рабочий контур (make up-prod): раскомментируйте и поправьте под деплой.
# ===========================================================================
# Перед первым запуском: заполните секреты выше, смонтируйте keystore с реальным
# сертификатом в /app/ssl/keystore.p12 (prod-preflight отвергнет CN=localhost),
# укажите внешний SMTP и origin'ы фронта. Секреты сюда не пишем — только
# в секции «Секреты».
#
#SPRING_PROFILES_ACTIVE=prod
#CAPTCHA_ENABLED=true
#CAPTCHA_MIN_FILL_SECONDS=3
#JWT_COOKIE_SAMESITE=Lax
#
# Общий домен cookie для поддоменов, например при раздельном домене файлов
# (STATIC_BASE_URL); пусто — host-only cookie
#JWT_COOKIE_DOMAIN=.example.com
#
# Origin'ы продового фронта, через запятую; localhost недопустим (preflight)
#CORS_ALLOWED_ORIGINS=https://app.example.com
#JWT_ISSUER=https://app.example.com
#JWT_AUDIENCE=https://app.example.com
#
# SMTP рабочего контура: внешний почтовый сервер, локального smtp здесь нет
# (профиль dev в make up-prod не входит)
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#
# За reverse-proxy (nginx/traefik на этом же хосте): читать X-Forwarded-For
# и класть его в логи и рейт-лимит
#TRUST_PROXY_HEADERS=true
#CLIENT_IP_FORWARDED_INDEX=-1
