# ===========================================================================
# Единственный env-шаблон проекта: секреты, специфичные для среды ключи
# и настройки инфраструктуры compose.
#
#   cp infrastructure/.env.example infrastructure/.env   # делает make env
#
# Рабочий файл infrastructure/.env в git не попадает. Он работает в двух
# ролях одновременно:
#   1) env_file контейнеров (app, alloy) — весь несекретный набор и секреты;
#   2) источник ${VAR}-интерполяции infrastructure/docker-compose.yaml.
#
# make env (.env нет) копирует этот шаблон и генерирует пустые секреты
# случайными значениями; существующий .env не меняет — только предупреждает
# о ключах, которых в нём нет.
#
# Несекретные дефолты (пороги рейт-лимитов, размеры батчей очистки, таймауты,
# CAPTCHA_POW_DIFFICULTY, ключи наблюдаемости и т.д.) заданы в
# application.properties через ${VAR:default} — править .env.example для
# этого не нужно. Меняйте здесь только секреты, специфичные для среды ключи
# (MAIL_HOST, CORS_ALLOWED_ORIGINS, DB_URL, MINIO_ENDPOINT) и настройку
# инфраструктуры (Keycloak, POSTGRES_USER/POSTGRES_DB).
#
# Интерполяция: ${VAR} и ${VAR:-default} внутри значений читаются из окружения
# compose (infrastructure/.env и переменные хоста). Правило про $: значение
# читается до попадания в контейнер, поэтому pa$sword станет pa — экранируйте
# как p$$ss. Строки в кавычки брать не нужно, но # внутри значения не работает:
# всё после # считается комментарием.

# ===========================================================================
# Секреты: заполните пустые значения, генерация — openssl rand -base64 32.
# ===========================================================================

# Секрет подписи и проверки JWT (HS256, base64, минимум 32 байта).
JWT_SECRET=

# HMAC-секрет подписи challenge и токенов капчи (PoW); минимум 32 символа.
# prod-preflight отвергает пустое и короткое значение, а также значение
# с префиксом dev-only из инструкций ниже.
CAPTCHA_HMAC_SECRET=

# Пароль PostgreSQL (общий для приложения и postgres-сервиса).
DB_PASSWORD=

# Необязательные переопределения инфраструктуры compose (дефолты user/desk):
#POSTGRES_USER=user
#POSTGRES_DB=desk

# Пароль от SMTP. Локальному smtp4dev аутентификация не нужна (пусто);
# рабочему SMTP — пароль учетной записи MAIL_USER (см. секцию «Рабочий контур»).
MAIL_PASSWORD=

# Пароль keystore. Keystore генерируется при старте контейнера,
# поэтому смена пароля не требует пересборки: поправить infrastructure/.env и
#   make restart
KEY_STORE_PASS=demo-keystore-pass

# Учётные данные root-пользователя MinIO (файлы вложений заявок): приложение
# читает их напрямую как MINIO_ROOT_USER/MINIO_ROOT_PASSWORD — переименований
# в MINIO_ACCESS_KEY/MINIO_SECRET_KEY больше нет. Пустое значение обязательной
# переменной валит compose на старте.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Пароль сервисной учётки HTTP Basic для /actuator/prometheus на управляющем
# порту (8081). Имя пользователя — METRICS_USER (секция «Наблюдаемость»).
# Пустое значение валит compose на старте — скрейп без пароля закрыт.
METRICS_PASSWORD=

# Начальный администратор Keycloak (профиль приложения keycloak, сервис
# keycloak). Создаётся только при пустой БД Keycloak; имя — KEYCLOAK_ADMIN
# (дефолт admin). Пароль необязателен: сервис живёт в профиле dev и слушает
# loopback, поэтому при пустом значении стенд поднимается с дефолтным admin —
# заполните, если стенд доступен не только вам.
KEYCLOAK_ADMIN_PASSWORD=

# Пароль отдельного кластера PostgreSQL, который держит схему Keycloak
# (сервис keycloak-postgres, профиль local-tools). Обязателен: пустое значение
# валит compose на старте. Креды приложения к основной БД (DB_PASSWORD) от него
# независимы — кластеры разные.
KEYCLOAK_DB_PASSWORD=

# ===========================================================================
# База данных: основная PostgreSQL.
# ===========================================================================
# Подключение приложения: по умолчанию — основная БД внутри compose-сети.
# reWriteBatchedInserts=true — batch-инсерты (EmailLog, attachments) реально
# батчатся на стороне драйвера PostgreSQL.
# Запуск приложения из IDE на хосту (профиль host) этот ключ перекрывает на
# 127.0.0.1:5432 — порт публикует infrastructure/docker-compose.override.yaml.
DB_URL=${DB_URL:-jdbc:postgresql://postgres:5432/desk?reWriteBatchedInserts=true}

# ===========================================================================
# MinIO: хранилище файлов вложений заявок.
# ===========================================================================
# Адрес — имя сервиса compose (внутренняя сеть data, не localhost). Учётки
# совпадают с root-ом MinIO и приходят из секции «Секреты» (MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD читаются приложением напрямую). Профиль host (IDEA/CLI)
# переопределяет адрес на 127.0.0.1:9000.
MINIO_ENDPOINT=http://minio:9000

# ===========================================================================
# Продукт: название, адреса писем, адрес раздачи файлов.
# ===========================================================================
# Название проекта и письма From/Reply-To.
APP_NAME=Real help desk
APP_PROJECT_NAME=real help desk
# MAIL_FROM и MAIL_NOTIFY — домены из application-domains.properties.
MAIL_FROM=noreply@example.com
MAIL_NOTIFY=admin@example.com
# Публичный адрес раздачи файлов (домен или ip:port) — из него API собирает
# downloadUrl в ответах; пусто — ссылки относительные, файлы отдаёт сам API.
STATIC_BASE_URL=

# ===========================================================================
# JWT: домены выдачи и CORS.
# ===========================================================================
# issuer/audience пишутся в токены и сверяются при валидации.
JWT_ISSUER=https://example.com
JWT_AUDIENCE=https://example.com
# Origin'ы фронта для CORS, список через запятую (см. cors.allowed-origins).
# Локальные origin'ы — здесь; без localhost для рабочего контура —
# в секции «Рабочий контур» (prod-preflight отвергает localhost).
CORS_ALLOWED_ORIGINS=https://localhost.ru,https://example.com

# ===========================================================================
# Почта: SMTP-сервер окружения.
# ===========================================================================
# Локально — smtp4dev (сервис профиля dev, UI на http://localhost:3000):
# без аутентификации, порт 25. Рабочий внешний SMTP задаётся в секции
# «Рабочий контур». Профиль prod проверяет это же preflight-ом: MAIL_HOST не
# localhost/127.0.0.1/«smtp», MAIL_PORT — число 1–65535, MAIL_FROM обязателен,
# при SMTP_AUTH=true нужен MAIL_USER.
MAIL_HOST=smtp

# Домен фронта в письмах (email.domain) — зависит от окружения.
FRONT_DOMAIN=front.example.ru

# ===========================================================================
# Keycloak: внешний выпуск токенов (профиль приложения keycloak, сервис keycloak).
# ===========================================================================
# Профиль включается в SPRING_PROFILES_ACTIVE (по умолчанию dev,keycloak).
# Значения ниже читает application-keycloak.properties — в схему базового
# application.properties они не входят.

# KC_JWK_SET_URI — адрес публичных ключей Keycloak, по нему приложение
# проверяет подпись токена. Запрос идёт из контейнера app, поэтому адрес —
# внутренний (имя сервиса compose keycloak и его порт 8080), а не localhost
# с хостовым портом.
KC_JWK_SET_URI=http://keycloak:8080/realms/realhelpdesk/protocol/openid-connect/certs
# KC_ISSUER_URI — ожидаемое значение claim iss. Оно должно совпадать с
# KC_HOSTNAME ниже: тот адрес Keycloak кладёт в токен (его видит браузер),
# а сетевой доступ к issuer не нужен — при заданном jwk-set-uri приложение
# только сверяет строку claim.
KC_ISSUER_URI=http://localhost:8180/realms/realhelpdesk
# KC_HOSTNAME — адрес Keycloak, видимый браузеру: страница входа, ссылки и iss
# токена. Внутри стека это 127.0.0.1:8180 (порт публикует сервис keycloak).
KC_HOSTNAME=http://localhost:8180
# Хостовый порт Keycloak (дефолт 8180: 8080 обычно занят другими стендами).
KEYCLOAK_PORT=8180
# Имя начального администратора Keycloak (пароль — секрет в секции «Секреты»);
# учётка создаётся только при пустой базе Keycloak.
KEYCLOAK_ADMIN=admin
# Имя базы Keycloak в отдельном кластере PostgreSQL (сервис keycloak-postgres,
# свой том keycloak_postgres_data). Схему приложения миграции Liquibase не
# касаются — кластеры разные.
KEYCLOAK_DB=keycloak

# ===========================================================================
# JVM: диагностика и память (перекрывают ENV образа).
# ===========================================================================
# Диагностика по умолчанию выключена (sec.md §7.8): пустое JAVA_* означает
# «не добавлять флаг», включение — ненулевое значение здесь же (entrypoint
# передаёт его в JVM). GC-логи всегда пишутся в stderr (образ, п. 6) —
# попадают в docker logs без файлов на диске. Пустое JAVA_XMX переключает
# entrypoint на -XX:MaxRAMPercentage, то есть heap масштабируется вместе с
# mem_limit (45% от 768m ≈ 345M).
JAVA_JFR_OPTS=
JAVA_HEAP_DUMP_OPTS=
JAVA_NMT_OPTS=
JAVA_JMX_OPTS=
JAVA_XMX=
JAVA_RAM_PERCENTAGE=45

# ===========================================================================
# Рабочий контур (make up-prod): раскомментируйте и поправьте под деплой.
# ===========================================================================
# Перед первым запуском: заполните секреты выше, смонтируйте keystore с реальным
# сертификатом в /app/ssl/keystore.p12 (prod-preflight отвергнет CN=localhost),
# укажите внешний SMTP и origin'ы фронта.
#
# Тег образа приложения из ghcr.io (deploy-workflow пишет сюда sha-<git_sha>;
# без тега up-prod берёт :latest). Сборка на сервере запрещена
# (infrastructure/docker-compose.prod.yaml — только pull).
#IMAGE_TAG=latest
#
# Профиль: docker-compose.prod.yaml уже подставляет дефолт prod, поэтому
# строку достаточно раскомментировать только для внешнего Keycloak (тогда
# приложение ждёт внешний сервер по KC_* адресам выше, локального нет).
#SPRING_PROFILES_ACTIVE=prod,keycloak
#CAPTCHA_ENABLED=true
#
# Общий домен cookie для поддоменов, например при раздельном домене файлов
# (STATIC_BASE_URL); пусто — host-only cookie
#JWT_COOKIE_DOMAIN=.example.com
#
# Origin'ы продового фронта, через запятую; localhost недопустим (preflight)
#CORS_ALLOWED_ORIGINS=https://app.example.com
#JWT_ISSUER=https://app.example.com
#JWT_AUDIENCE=https://app.example.com
#
# SMTP рабочего контура: внешний почтовый сервер, локального smtp здесь нет
# (профиль dev в make up-prod не входит)
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#
# За reverse-proxy (nginx/traefik на этом же хосте): читать X-Forwarded-For
# и класть его в логи и рейт-лимит
#TRUST_PROXY_HEADERS=true
#CLIENT_IP_FORWARDED_INDEX=-1
